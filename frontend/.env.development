# 开发环境配置
ENV = 'development'

# Jeeplus快速开发平台/开发环境
VUE_APP_BASE_API = '/api'

# Jeeplus快速开发平台/后台地址
VUE_APP_SERVER_URL = 'http://localhost:8087/'

#单点登录设置
VUE_APP_SSO_LOGIN  = 'false'
VUE_APP_CAS_SERVER = 'https://authserver.ncwu.edu.cn/authserver'
VUE_APP_CLIENT_LOGIN = 'http://localhost:3000/#/casLogin'

VUE_APP_JT1078_SERVER_IP = '127.0.0.1'
VUE_APP_JT1078_SERVER_TCP_PORT = '8084'
VUE_APP_JT1078_SERVER_UDP_PORT = '8086'


VUE_APP_URL_ENV = development

# ===== 1号(前端GIS) 高德地图配置 =====
# ⚠️ 真实的 Key 不要填在这里（本文件会被提交，任务书禁止提交 API Key）。
#    请填到 .env.development.local —— 该文件已被 .gitignore 排除，且优先级高于本文件。
#    留空时页面自动使用内置离线矢量地图（功能完整，可正常演示）。
VUE_APP_AMAP_KEY = ''
# 2021-12-02 之后申请的 Key 必须同时配置安全密钥，否则高德会拒绝加载。
VUE_APP_AMAP_SECURITY_CODE = ''
VUE_APP_AMAP_VERSION = '2.0'
